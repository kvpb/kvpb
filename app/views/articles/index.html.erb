<% content_for :title, "Read" %>

<section id="read">
	<% if superuser? %>
		<p class="superuser_controls"><%= link_to "New article", new_article_path %></p>
	<% end %>

	<% if @articles.empty? %>
		<p>Nothing published yet.</p>
	<% end %>

	<% @articles.each do |article| %>
		<article class="<%= article.published? ? "published" : "draft" %>">
			<% unless article.published? %><p class="status_badge">Draft</p><% end %>
			<% if article.cover_image.attached? %>
				<%= link_to article_path(article) do %><%= image_tag article.cover_image, class: "cover_image" %><% end %>
			<% end %>
			<% if article.kicker.present? %><p class="kicker"><%= article.kicker %></p><% end %>
			<h2 class="headline"><%= link_to article.headline, article_path(article) %></h2>
			<% if article.subheadline.present? %><p class="subheadline"><%= article.subheadline %></p><% end %>
			<% if article.lede.present? %><p class="lede"><%= article.lede %></p><% end %>
		</article>
	<% end %>
</section>
