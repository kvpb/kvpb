
<section id="journal">
	<p class="dateline"><%= journal_dateline %></p>

	<% if @articles.empty? %>
		<p>Nothing published yet.</p>
	<% end %>

	<div class="front_page">
		<%# rank comes from where an article lands in the ordered list, not from the number typed into
		    it, so the page keeps a proper hierarchy however many articles there are and Karl never has
		    to match a rank number against a headline size %>
		<% @articles.each_with_index do |article, index| %>
			<%= render "story", article: article, rank: ( index.zero? ? "splash" : index < 3 ? "feature" : "brief" ) %>
		<% end %>
	</div>

	<% if @total_pages > 1 %>
		<nav class="pagination">
			<% if @page < @total_pages %><%= link_to "Older", read_path( page: @page + 1 ), data: { controller: "blink-on-press" } %><% end %>
			<% if @page > 1 %><%= link_to "Newer", read_path( page: @page - 1 ), data: { controller: "blink-on-press" } %><% end %>
		</nav>
	<% end %>
</section>

