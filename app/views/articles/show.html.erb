<% content_for :title, @article.headline.presence %>

<article id="article" class="<%= @article.published? ? "published" : "draft" %>">
	<% if @article.cover_image.attached? %>
		<%= image_tag @article.cover_image, class: "cover_image" %>
	<% end %>

	<header>
		<% if @article.kicker.present? %><p class="kicker"><%= smart_quotes( @article.kicker ) %></p><% end %>
		<h1 class="headline"><%= smart_quotes( @article.headline ) %></h1>
		<% if @article.subheadline.present? %><p class="subheadline"><%= smart_quotes( @article.subheadline ) %></p><% end %>
	</header>

	<% if @article.lede.present? %><p class="lede"><%= smart_quotes( @article.lede ) %></p><% end %>

	<div class="body"><%= smart_format( @article.body ) %></div>
</article>

<section id="comments">
	<h2>Comments</h2>

	<% if @comments.empty? %>
		<p>No comments yet.</p>
	<% else %>
		<%= render @comments %>
	<% end %>

	<% if superuser? && @pending_comments.any? %>
		<div id="pending_comments">
			<h3>Pending</h3>
			<% @pending_comments.each do |comment| %>
				<div class="comment pending">
					<p class="comment_author"><%= comment.author_display_name %> — <%= comment.author_email %></p>
					<p class="comment_body"><%= smart_quotes( comment.body ) %></p>
					<%= button_to "Approve", approve_article_comment_path( @article, comment ), method: :patch %>
					<%= button_to "Reject", reject_article_comment_path( @article, comment ), method: :delete, data: { turbo_confirm: "Reject and delete this comment? The author will be emailed a copy." } %>
				</div>
			<% end %>
		</div>
	<% end %>

	<% if @article.comments_locked? %>
		<p class="comments_locked">Comments are locked for this article.</p>
	<% else %>
		<%= render "comments/form", article: @article, comment: @comment %>
	<% end %>
</section>

