<%= form_with model: passage, url: ( passage.persisted? ? passage_path( album, passage ) : passages_path( album ) ), scope: :passage do |form| %>
	<% if passage.errors.any? %>
		<ul class="errors">
			<% passage.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
		</ul>
	<% end %>

	<%= form.label :position, "Position" %>
	<%= form.number_field :position %>
	<p class="field_hint">Where this sits in the album. A passage shares its numbering with the photos and comes before the photo of the same number, so 3 puts it just above photo 3. Past the last photo closes the album.</p>

	<%= form.label :heading, "Heading" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_field :heading %>
	</div>
	<p class="field_hint">Optional. On its own, it opens a section — a date, a place, a leg of the trip.</p>

	<%= form.label :body, "Body" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_area :body %>
	</div>
	<p class="field_hint">Optional. The prose itself. One or the other has to be filled in.</p>

	<%= form.submit passage.persisted? ? "Save changes" : "Add passage" %>
<% end %>

