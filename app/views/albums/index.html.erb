
<section id="gallery">
	<% if @albums.empty? %>
		<p>Nothing here yet.</p>
	<% end %>

	<% @albums.each do |album| %>
		<% photos = album.photos.to_a %>
		<% if photos.size == 1 %>
			<div class="album_solo <%= "draft" unless album.published? %>">
				<%= image_tag photos[ 0 ].image, class: "album_photo", draggable: false %>
				<p class="album_meta">
					<span class="album_title"><%= smart_quotes( album.title ) %></span>
					<%= render "photos/info", photo: photos[ 0 ] %>
				</p>
			</div>
		<% else %>
			<%= link_to album_path( album ), class: "album_cover_flow #{"draft" unless album.published?}" do %>
				<div class="cover_flow_stage" data-controller="cover-flow-depth">
					<% if photos[3] %><%= image_tag photos[3].image, class: "cover_flow_hint cover_flow_hint_left", draggable: false, data: { controller: "medallion-physics", medallion_physics_max_drag_fraction_value: "0.015", medallion_physics_scroll_kick_value: "0.25", cover_flow_depth_target: "hint" } %><% end %>
					<% if photos[1] %><%= image_tag photos[1].image, class: "cover_flow_side cover_flow_side_left", draggable: false, data: { controller: "medallion-physics", cover_flow_depth_target: "side" } %><% end %>
					<% if photos[0] %><%= image_tag photos[0].image, class: "cover_flow_cover", draggable: false %><% end %>
					<% if photos[2] %><%= image_tag photos[2].image, class: "cover_flow_side cover_flow_side_right", draggable: false, data: { controller: "medallion-physics", cover_flow_depth_target: "side" } %><% end %>
					<% if photos[4] %><%= image_tag photos[4].image, class: "cover_flow_hint cover_flow_hint_right", draggable: false, data: { controller: "medallion-physics", medallion_physics_max_drag_fraction_value: "0.015", medallion_physics_scroll_kick_value: "0.25", cover_flow_depth_target: "hint" } %><% end %>
				</div>
				<%= render "caption", album: album %>
			<% end %>
		<% end %>
	<% end %>

	<% if @total_pages > 1 %>
		<nav class="pagination">
			<% if @page < @total_pages %><%= link_to "Older", see_path( page: @page + 1 ), data: { controller: "blink-on-press" } %><% end %>
			<% if @page > 1 %><%= link_to "Newer", see_path( page: @page - 1 ), data: { controller: "blink-on-press" } %><% end %>
		</nav>
	<% end %>
</section>

