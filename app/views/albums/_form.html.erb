<%= form_with model: album, url: ( album.persisted? ? album_path( album ) : see_path ), scope: :album do |form| %>
	<% if album.errors.any? %>
		<ul class="errors">
			<% album.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
		</ul>
	<% end %>

	<%= form.label :title, "Title" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_field :title, required: true %>
	</div>

	<%= form.label :location, "Location" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_field :location %>
	</div>

	<%= form.label :taken_on, "Taken on" %>
	<%= form.date_field :taken_on %>

	<%= form.label :description, "Description" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_area :description %>
	</div>

	<%= form.label :cover_photo, "Cover photo" %>
	<%= form.file_field :cover_photo, accept: "image/*" %>
	<p class="field_hint">Optional. Defaults to the first photo.</p>

	<%= form.label :photos, "Photos" %>
	<%= form.file_field :photos, multiple: true, accept: "image/*" %>
	<p class="field_hint">Newly selected photos are added to the album; existing ones stay.</p>

	<%= form.label :published_at, "Publish at" %>
	<%= form.datetime_field :published_at, value: album.published_at&.strftime( "%Y-%m-%dT%H:%M" ) %>
	<p class="field_hint">Blank stays a draft. A future date schedules it. Now or the past publishes it immediately.</p>

	<%= form.submit album.persisted? ? "Save changes" : "Create album" %>
<% end %>

