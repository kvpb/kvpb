<%= form_with model: milestone, url: ( milestone.persisted? ? milestone_path( milestone ) : milestones_path ), scope: :milestone do |form| %>
	<% if milestone.errors.any? %>
		<ul class="errors">
			<% milestone.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
		</ul>
	<% end %>

	<%= form.label :kind, "Kind" %>
	<%= form.select :kind, Milestone.kinds.keys.map { |k| [ k.capitalize, k ] } %>

	<%= form.label :title, "Title" %>
	<%= form.text_field :title, required: true %>

	<%= form.label :organization, "Organization" %>
	<%= form.text_field :organization %>

	<%= form.label :location, "Location" %>
	<%= form.text_field :location %>

	<%= form.label :starts_on, "Starts on" %>
	<%= form.date_field :starts_on, required: true %>

	<%= form.label :ends_on, "Ends on" %>
	<%= form.date_field :ends_on %>
	<p class="field_hint">Blank means ongoing.</p>

	<%= form.label :date_label, "Date label (override)" %>
	<%= form.text_field :date_label %>
	<p class="field_hint">Leave blank to compute from starts on / ends on. Use this for anything less precise than a month, like a decade.</p>

	<%= form.label :description, "Description" %>
	<%= form.text_area :description %>

	<%= form.submit milestone.persisted? ? "Save changes" : "Create milestone" %>
<% end %>

