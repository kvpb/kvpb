<%= form_with model: print, url: ( print.persisted? ? backend_print_path( print ) : backend_prints_path ), scope: :print do |form| %>
	<% if print.errors.any? %>
		<ul class="errors">
			<% print.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
		</ul>
	<% end %>

	<%= form.label :title, "Title" %>
	<div class="text_field_glass" data-controller="squircle-dash-border">
		<%= form.text_field :title %>
	</div>

	<%= form.label :image, "Photo" %>
	<%= form.file_field :image, accept: "image/*" %>
	<p class="field_hint"><%= print.image.attached? ? "Currently: #{ print.image.filename }. Choosing another replaces it." : "A JPEG, PNG, GIF, WebP, HEIC or RAW — anything else Active Storage or a RAW converts is shown as a JPEG made from it, on first request." %></p>

	<%= form.label :published_at, "Publish at" %>
	<%= form.datetime_field :published_at, value: print.published_at&.strftime( "%Y-%m-%dT%H:%M" ) %>
	<p class="field_hint">Blank stays a draft. A future date schedules it. Now or the past publishes it immediately.</p>

	<%= form.submit print.persisted? ? "Save changes" : "Create print" %>
<% end %>

